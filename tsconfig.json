{
  // Type-checking only: Node runs the .ts files directly by stripping types, so nothing is emitted.
  // `erasableSyntaxOnly` rejects TS features that need real compilation (enums, namespaces,
  // constructor parameter properties, `import x = require()`), keeping the code runnable as-is.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["engine", "reactions", "sdk", "fetchers", "test"]
}
